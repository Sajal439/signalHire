# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/jobfitengine

# ── Clerk (auth) ──────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_aW50ZW5zZS1kaW5vc2F1ci0xMzU1LmNsZXJrLmFjY291bnRzLmRldiQ
CLERK_SECRET_KEY=sk_test_saq2MmjTlHQcX4RievmybdkPuS0t5G4G6c4M2eppwi

# Clerk webhook secret — set after creating a webhook in Clerk dashboard
# Endpoint: POST /api/webhooks/clerk   Events: user.created, user.updated
CLERK_WEBHOOK_SECRET=whsec_...

# Clerk redirect URLs (leave as-is for local dev)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Google Gemini (Free API Key from https://aistudio.google.com) ──────────────
GEMINI_API_KEY=AIzaSy...

# ── Telegram (optional — only needed if you want daily Telegram digests) ──────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Pipeline tuning ───────────────────────────────────────────────────────────
# Minimum cosine similarity (0–1) for a job to pass to the LLM scoring step
MIN_SIMILARITY=0.30
# Number of top matches to show in the daily digest / dashboard
DIGEST_TOP_N=10
# How many jobs to embed per OpenAI batch request
EMBED_BATCH_SIZE=20
